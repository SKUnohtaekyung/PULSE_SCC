POSTGRES_DB=scc
POSTGRES_USER=scc
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/scc
SERVER_PORT=8080
ANALYSIS_SERVICE_BASE_URL=http://127.0.0.1:8000
ANALYSIS_SERVICE_TOKEN=replace-with-a-shared-local-token
ANALYSIS_CONNECT_TIMEOUT=5s
ANALYSIS_READ_TIMEOUT=5m
ANALYSIS_IMAGE_STORAGE_PATH=../storage/personas
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-android-client-id

SCC_ENVIRONMENT=local
SCC_HOST=127.0.0.1
SCC_PORT=8000
SCC_DATABASE_URL=postgresql://scc:replace-with-a-local-password@localhost:5432/scc
SCC_SERVICE_TOKEN=replace-with-a-shared-local-token
SCC_OPENAI_API_KEY=replace-with-openai-api-key
SCC_OPENAI_ANALYSIS_MODEL=gpt-6-astra
SCC_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
SCC_REVIEW_COLLECTION_LIMIT=120
SCC_REVIEW_COLLECTION_TIMEOUT_SECONDS=45
